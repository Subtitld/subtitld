QPushButton {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a5f70, stop:1 #3e5363);
    padding: 6px 12px;
    outline: none;
    font-family: 'Montserrat';
    font-size: 11px;
    font-weight: 700;
    color: #b8cee0;
    text-transform: uppercase;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #566f84, stop:1 #4a5f70);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2e3e4c, stop:1 #3a4d5d);
}

QPushButton#scope_range_capture_button {
    padding: 4px 8px;
    font-size: 13px;
    min-width: 0px;
}

/* ====================================================================
   Subtitld Cloud dashboard (Global → Subtitld Cloud tab)
   See interface/cloud_dashboard.py. Card with identity header, balance
   ring band, and usage-history band; plus a not-connected empty card.
   ==================================================================== */

QWidget#cloud_card {
    background: rgba(62, 83, 99, 0.9);
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.45);
}

QWidget#cloud_header_band {
    background: rgba(0, 0, 0, 0.16);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QWidget#cloud_balance_band {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QLabel#cloud_avatar {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a5f70, stop:1 #34454f);
    color: #b8cee0;
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
}

QLabel#cloud_email {
    color: #ffffff;
    font-family: 'Montserrat';
    font-weight: 600;
    font-size: 12px;
}

QLabel#cloud_key_badge {
    color: rgba(184, 206, 224, 0.75);
    background: rgba(184, 206, 224, 0.1);
    border: 1px solid rgba(184, 206, 224, 0.18);
    border-radius: 2px;
    padding: 1px 6px;
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
}

QLabel#cloud_status_dot {
    background: #55d43f;
    border-radius: 3px;
}
QLabel#cloud_status_dot[state="low"] {
    background: #c55252;
}

QLabel#cloud_status_label {
    color: rgba(184, 206, 224, 0.65);
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
}
QLabel#cloud_status_label[state="low"] {
    color: #c55252;
}

QPushButton#cloud_icon_button {
    background: transparent;
    border: 0;
    border-radius: 2px;
    padding: 0px;
}
QPushButton#cloud_icon_button:hover {
    background: rgba(184, 206, 224, 0.14);
}
QPushButton#cloud_icon_button:pressed {
    background: rgba(184, 206, 224, 0.08);
}

QWidget#cloud_usage_header_band {
    background: rgba(0, 0, 0, 0.12);
}

QLabel#cloud_wlabel {
    color: rgba(184, 206, 224, 0.55);
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
}

QLabel#cloud_subtle_label {
    color: rgba(184, 206, 224, 0.4);
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
}

QWidget#cloud_usage_row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
QWidget#cloud_usage_row[last="yes"] {
    border-bottom: 0px;
}

QLabel#cloud_usage_file {
    color: rgba(255, 255, 255, 0.9);
    font-family: 'Montserrat';
    font-size: 12px;
}

QLabel#cloud_usage_duration {
    color: rgba(184, 206, 224, 0.6);
    font-family: 'Montserrat';
    font-size: 11px;
}

QLabel#cloud_usage_cost {
    color: rgba(255, 255, 255, 0.85);
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 12px;
}

/* --- not-connected empty card --- */
QLabel#cloud_icon_tile {
    background: rgba(184, 206, 224, 0.08);
    border: 1px solid rgba(184, 206, 224, 0.18);
    border-radius: 3px;
}

QLabel#cloud_empty_title {
    color: #ffffff;
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 14px;
}

QLabel#cloud_empty_body {
    color: rgba(184, 206, 224, 0.7);
    font-family: 'Montserrat';
    font-size: 11px;
}

QLabel#cloud_empty_error {
    color: #c55252;
    font-family: 'Montserrat';
    font-size: 11px;
}

QLineEdit#cloud_key_field {
    background: #3e5363;
    border: 1px solid rgba(0, 0, 0, 0.3);
    border-radius: 2px;
    padding: 0px 10px;
    min-height: 28px;
    color: rgba(255, 255, 255, 0.92);
    font-family: 'Montserrat';
    font-size: 12px;
}

QPushButton#cloud_link_button {
    background: transparent;
    border: 0;
    color: rgba(184, 206, 224, 0.55);
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
}
QPushButton#cloud_link_button:hover {
    color: #b8cee0;
}

QLabel {
    color: #ffffff;
}

QLabel[class='widget_label'] {
    font-family: 'Montserrat';
    font-size: 9px;
    font-weight: 700;
    color: #b8cee0;
    text-transform: uppercase;
    padding: 2px 0 2px -2px;
}


QLabel[class='widget_label']::disabled {
    color: #1ab8cee0;
}


QLabel[class='units_label'] {
    font-size: 9px;
    color: #80b8cee0;
    padding: 0 4px;
}

/* ---- Transcription options area + bottom footer ---- */
/* Content area (per-engine ASR settings) — subtle top-down gradient. */
QStackedWidget#transcription_options_area {
    background: transparent;
    border-radius: 2px;
}

QWidget#transcription_footer {
    background: transparent;
}

/* ---- Scope selector ---- */
/* The ALL row (chip + bar) carries a subtle top-down gradient — fully
   transparent at the top, easing to a faint dark at the bottom — so it
   grounds the row against the divider/Start button below without reading
   as a hard-edged fill. */
QWidget#transcription_scope_area {
    background: transparent;
}

QWidget#transcription_footer_bottom_line {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 0, 0, 0.1), stop:1 rgba(0, 0, 0, 0));
}

/* Full-width delimiter that sits BELOW the scope row and ABOVE the Start
   button. It's its own edge-to-edge 1px strip, so it touches both panel
   edges while the chip and button keep their side padding. Same slate as
   the chip/bar so an expanded (full-width) bar flows straight into it. */
QWidget#transcription_footer_divider {
    background: #1e2832;
}

/* Chip is a TAB: TOP corners rounded, BOTTOM square, SAME colour as the
   bar so an open (checked) chip + bar read as one connected shape. */
QPushButton#transcription_scope_chip {
    background: #1e2832;
    color: rgba(184, 206, 224, 0.6);
    border: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 4px 9px;
    font-family: 'Montserrat';
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}
QPushButton#transcription_scope_chip:hover {
    color: #b8cee0;
}

/* Bar shares the chip colour (square band that the chip tabs onto). */
QWidget#transcription_scope_bar {
    background: #1e2832;
}

/* SCOPE dropdown + FROM/TO inputs share the slate-input look: dark box,
   white value text, tabular numerals. */
QComboBox#transcription_scope_combobox,
QLineEdit#transcription_scope_input {
    background: #3e5363;
    border: 1px solid rgba(0, 0, 0, 0.3);
    border-radius: 2px;
    padding: 4px 10px;
    min-height: 20px;
    color: rgba(255, 255, 255, 0.92);
    font-family: 'Montserrat';
    font-size: 13px;
}
QComboBox#transcription_scope_combobox {
    font-weight: 600;
}
QComboBox#transcription_scope_combobox::drop-down {
    background: transparent;
    border: 0;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    image: url(graphics:combobox_down_arrow.svg);
    padding: 0 8px 0 0;
    width: 10px;
}
QComboBox#transcription_scope_combobox QAbstractItemView {
    background: #3e5363;
    color: #b8cee0;
    selection-background-color: #4a5f70;
    border: 1px solid rgba(0, 0, 0, 0.3);
    outline: 0;
}

/* DURATION is read-only/computed — same box shape, muted text. */
QLabel#transcription_scope_duration_value {
    background: #304251;
    border: 1px solid rgba(0, 0, 0, 0.3);
    border-radius: 2px;
    padding: 5px 10px;
    color: rgba(184, 206, 224, 0.5);
    font-family: 'Montserrat';
    font-size: 13px;
}

/* Start button: BOTTOM radius only — square top, rounded bottom — so it
   rises out of the footer band and sits flush at the panel's bottom. */
QPushButton#transcription_start_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c8dbe9, stop:1 #b8cee0);
    color: #3e5363;
    border: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding: 7px 16px;
    font-family: 'Montserrat';
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}
QPushButton#transcription_start_button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d6e4ef, stop:1 #c8dbe9);
}
QPushButton#transcription_start_button:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #b8cee0, stop:1 #a9c1d4);
}

QLabel[class='metadata_field_label'] {
    font-family: 'Montserrat';
    font-size: 9px;
    font-weight: 700;
    color: #80b8cee0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding-top: 1px;
}

QLabel[class='metadata_field_value'] {
    font-size: 12px;
    color: #d8e6f2;
    background: transparent;
}

QLabel[class='metadata_field_value'][empty='true'] {
    color: #66b8cee0;
    font-style: italic;
}

QLabel[class='metadata_badge'] {
    font-family: 'Montserrat';
    font-size: 10px;
    font-weight: 600;
    color: #d8e6f2;
    background-color: rgba(184, 206, 224, 0.10);
    border: 1px solid rgba(184, 206, 224, 0.20);
    border-radius: 9px;
    padding: 2px 10px;
}

QPushButton[class='filter_pill'] {
    font-family: 'Montserrat';
    font-size: 10px;
    font-weight: 600;
    color: #b8cee0;
    background-color: rgba(184, 206, 224, 0.06);
    border: 1px solid rgba(184, 206, 224, 0.15);
    border-radius: 11px;
    padding: 3px 12px;
    text-transform: none;
}

QPushButton[class='filter_pill']:hover {
    background-color: rgba(184, 206, 224, 0.12);
    border-color: rgba(184, 206, 224, 0.28);
}

QPushButton[class='filter_pill']:checked {
    color: #1a2632;
    background-color: #b8cee0;
    border-color: #b8cee0;
}

QPushButton[class='filter_pill']:checked:hover {
    background-color: #c8d8e8;
    border-color: #c8d8e8;
}

/* Combobox flavour of the filter pill — used for the language picker
   so it sits visually inside the same row as the toggle pills. We
   mirror the closed-state look of the QPushButton variant (rounded,
   same color tokens, same font) and reserve a strip of right padding
   for the dropdown arrow. The :on selector fires while the popup is
   open and matches the QPushButton :checked treatment so the picker
   reads "active" the same way an active toggle does. */
QComboBox[class='filter_pill'] {
    font-family: 'Montserrat';
    font-size: 10px;
    font-weight: 600;
    color: #b8cee0;
    background-color: rgba(184, 206, 224, 0.06);
    border: 1px solid rgba(184, 206, 224, 0.15);
    border-radius: 11px;
    padding: 3px 22px 3px 12px;
    min-height: 16px;
}

QComboBox[class='filter_pill']:hover {
    background-color: rgba(184, 206, 224, 0.12);
    border-color: rgba(184, 206, 224, 0.28);
}

QComboBox[class='filter_pill']:on {
    color: #1a2632;
    background-color: #b8cee0;
    border-color: #b8cee0;
}

QComboBox[class='filter_pill']::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
}

/* Tiny CSS-only chevron via border tricks so we don't have to ship a
   PNG. Color matches the pill text in both rest and active states. */
QComboBox[class='filter_pill']::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #b8cee0;
    margin-right: 8px;
}

QComboBox[class='filter_pill']:on::down-arrow {
    border-top-color: #1a2632;
}

/* The popup list itself — keep it readable rather than pill-shaped.
   Slightly lifted background so it stands off the dialog's surface. */
QComboBox[class='filter_pill'] QAbstractItemView {
    font-family: 'Montserrat';
    font-size: 11px;
    color: #d8e6f2;
    background-color: #2a3845;
    border: 1px solid rgba(184, 206, 224, 0.25);
    border-radius: 4px;
    padding: 2px;
    selection-background-color: #b8cee0;
    selection-color: #1a2632;
    outline: none;
}

QLabel[class='addons_empty_state'] {
    font-family: 'Montserrat';
    font-size: 12px;
    color: #66b8cee0;
    background: transparent;
    padding: 24px;
}

/* Add-on card — one widget per add-on in the list. Replaces the older
   QListWidgetItem-based row so each entry can host its own action buttons
   and word-wrap nicely on narrow widths. */
QWidget[class='addon_card'] {
    background-color: rgba(184, 206, 224, 0.05);
    border: 1px solid rgba(184, 206, 224, 0.15);
    border-radius: 6px;
}

QWidget[class='addon_card']:hover {
    background-color: rgba(184, 206, 224, 0.08);
    border-color: rgba(184, 206, 224, 0.25);
}

QLabel[class='addon_card_title'] {
    font-family: 'Montserrat';
    font-size: 13px;
    font-weight: 600;
    color: #e8f0f8;
    background: transparent;
}

QLabel[class='addon_card_version'] {
    font-family: 'Montserrat';
    font-size: 10px;
    font-weight: 600;
    color: #98b0c4;
    background: transparent;
}

QLabel[class='addon_card_badge'] {
    font-family: 'Montserrat';
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    color: #1a2632;
    background-color: #b8cee0;
    border-radius: 3px;
    padding: 2px 6px;
}

QLabel[class='addon_card_badge_update'] {
    font-family: 'Montserrat';
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    color: #1a2632;
    background-color: #f0c060;
    border-radius: 3px;
    padding: 2px 6px;
}

QLabel[class='addon_card_summary'] {
    font-family: 'Montserrat';
    font-size: 11px;
    color: #c8d8e8;
    background: transparent;
}

QLabel[class='addon_card_meta'] {
    font-family: 'Montserrat';
    font-size: 10px;
    color: #88a0b4;
    background: transparent;
}

QLabel[class='addon_card_state'] {
    font-family: 'Montserrat';
    font-size: 10px;
    font-style: italic;
    color: #88a0b4;
    background: transparent;
}

QScrollArea#addons_panel_scroll {
    background: transparent;
    border: none;
}

QWidget#addons_panel_scroll_inner {
    background: transparent;
}

QLabel[class='metadata_field_image'] {
    background: transparent;
    border: 1px solid rgba(184, 206, 224, 0.15);
    border-radius: 4px;
    padding: 0;
}

QCheckBox {
    font-family: 'Montserrat';
    font-size: 11px;
    font-weight: 400;
    color: #b8cee0;
    text-transform: none;
    padding: 2px 0;
    spacing: 8px;
}

QPushButton[class="danger"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c55252, stop:1 #a94444);
    color: #ffffff;
}

QPushButton[class="danger"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d46464, stop:1 #b05050);
}

QPushButton[class="secondary"] {
    border-image: url(graphics:button_secondary_normal.svg) 3 3 3 3 stretch stretch;
    background: transparent;
    color: #3e5363;
}

QPushButton[class="secondary"]:hover {
    border-image: url(graphics:button_secondary_hover.svg) 3 3 3 3 stretch stretch;
}

QPushButton[class="secondary"]:pressed {
    border-image: url(graphics:button_secondary_pressed.svg) 3 3 3 3 stretch stretch;
}

QPushButton[class="primary"] {
    border-image: url(graphics:button_primary_normal.svg) 3 3 3 3 stretch stretch;
    background: transparent;
    color: #ffffff;
}

QPushButton[class="primary"]:hover {
    border-image: url(graphics:button_primary_hover.svg) 3 3 3 3 stretch stretch;
}

QPushButton[class="primary"]:pressed {
    border-image: url(graphics:button_primary_pressed.svg) 3 3 3 3 stretch stretch;
}

QPushButton::disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #40566a80, stop:1 #3e536380);
    color: #66b8cee0;
    border-top-color: rgba(255, 255, 255, 15);
    border-bottom-color: rgba(0, 0, 0, 20);
}

QMainWindow {
    background: qlineargradient( x1:0 y1:0, x2:0 y2:1, stop:0 rgb(7,9,11), stop:1 rgb(26,35,43));
    background-image: url(graphics:background_watermark.svg);
    background-repeat: no-repeat;
    background-position: center;
}

QSplitter::hover {
    background-color: transparent;
}

#main_vertical_splitter::handle {
    margin-top:-1px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0 2px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(136, 136, 136, 0.5); /* semi-transparent */
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(85, 85, 85, 0.7); /* darker on hover */
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(136, 136, 136, 0.5);
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(85, 85, 85, 0.7);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QScrollBar:corner {
    background: transparent;
}

QListView,
QScrollBar,
QTextEdit {
    border: none;
    outline: none;
    background-color: transparent;
    padding: 0;
}

QToolTip {
    background-color: #e51a232b;
    color: white;
    padding: 2px;
    font-size: 10px;
    border: 0;
}

QLineEdit[class=qlineedit_timings] {
    outline: none;
    margin: 0;
    border: 0;
    padding: 0;
    font-size: 10px;
    color: grey;
    border-radius: 0;
    background-color: transparent;
}


QSpinBox,
QDoubleSpinBox,
QComboBox {
    padding-left:1px;
    border: 0;
    background-color: #3e5363;
    min-width: 40px;
    border-radius: 2px;
    font-size: 10px;
    color:#b8cee0;
    padding: 2px;
}

QSpinBox::disabled,
QDoubleSpinBox::disabled,
QComboBox::disabled {
    background-color: #803e5363;
}

QComboBox {
    padding-left:2px;
    font-size: 11px;
}

QComboBox::hover {
    background-color: #304251;
}

QComboBox::drop-down {
    background-color: #304251;
    border: 0;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
}

/* QComboBox::drop-down:on {
    background-color: darkgray;
}

QComboBox::drop-down:disabled {
    background-color: #CCC;
} */

LabeledComboBox,
LabeledLineEdit {
    background-color: #304251; 
    border-radius: 2px;
}

LabeledComboBox QComboBox,
LabeledLineEdit QLineEdit {
    background-color: #304251; 
    border: 0;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    font-size: 12px;
    color:#b8cee0;
    padding: 6px;
}

LabeledComboBox QComboBox::hover,
LabeledLineEdit QLineEdit::hover {
    background-color: #3e5363; 
}


LabeledComboBox QComboBox::drop-down {
    background-color: transparent;
    border-top-right-radius: 0;
    image: url(graphics:combobox_down_arrow.svg);
    subcontrol-origin: padding;
    subcontrol-position: top right;
    padding: 0 6px;
}

LabeledComboBox QLabel,
LabeledLabel #top_label,
LabeledLineEdit #top_label {
    font-family: 'Montserrat';
    font-size: 9px;
    color:#b8cee0;
    text-transform: uppercase;
    font-weight: 700;
    padding: 4px;
}

LabeledLabel,
QProgressBar {
    background-color: #33304251; 
    border-radius: 2px;
}

LabeledLabel #label {
    font-size: 12px;
    color:#b8cee0;
    padding: 0 6px 6px 6px;
}

QProgressBar {
    color: #3e5363;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #b8cee0;
    border-radius: 2px;
}

/* Transcription progress bar fills the whole bottom row during a run, so it
   sits flush in the corners — square edges, no rounding. */
QProgressBar#transcription_progress_bar,
QProgressBar#transcription_progress_bar::chunk {
    border-radius: 0;
}

QProgressBar#addon_card_progress_bar {
    background: rgba(184, 206, 224, 0.10);
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 4px 0;
    min-height: 1px;
    max-height: 1px;
}

QProgressBar#addon_card_progress_bar::chunk {
    background-color: #b8cee0;
    border-radius: 0;
    margin: 0;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: 0;
    padding: 3 5 0 0;
    border-top-right-radius: 2px;
    image: url(graphics:spinbox_arrow_up.svg);
}

QSpinBox::up-button[class=spin_playercontrols],
QDoubleSpinBox::up-button[class=spin_playercontrols] {
    margin-top: 3px;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    image: url(graphics:spinbox_arrow_up.svg);
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::up-button:off,
QDoubleSpinBox::up-button:off {
    background-color: none;
    image: none;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: 0;
    padding: 0 5 3 0;
    border-bottom-right-radius: 2px;
    image: url(graphics:spinbox_arrow_down.svg);
}

QSpinBox::down-button[class=spin_playercontrols],
QDoubleSpinBox::down-button[class=spin_playercontrols] {
    margin-bottom: 3px;
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    /* background-color: #e5b3b3b3; */
    image: url(graphics:spinbox_arrow_down.svg);
}

QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QSpinBox::down-button:off,
QDoubleSpinBox::down-button:off {
    background-color: none;
    image: none;
}


QSlider::groove:horizontal {
    outline: none;
    margin: 0;
    padding: 0;
    background: #803e5363;
}

QSlider::handle:horizontal {
    outline: none;
    border: 0;
    padding: 0;
    width: 10px;
    background: #3e5363;
}

QSlider::handle:horizontal:disabled {
    background: transparent;
}

QCheckBox::indicator,
QGroupBox::indicator {
    width: 16px;
    height: 16px;
}
    
QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
    image: url(graphics:checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover,
QGroupBox::indicator:checked:hover {
    image: url(graphics:checkbox_checked_hover.svg);
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked {
    image: url(graphics:checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:hover {
    image: url(graphics:checkbox_unchecked_hover.svg);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
    image: url(graphics:checkbox_disabled.svg);
}

QGroupBox {
    border-image: url(graphics:groupbox_background.svg) 3 3 3 3 stretch stretch;
    border-width: 3px;
    margin-left: 8px;
    padding: 20 10 10 13;
    background: transparent;
    font-family: 'Montserrat';
    font-size: 11px;
    color: #b8cee0;
}


QGroupBox:disabled {
    border-image: url(graphics:groupbox_background_disabled.svg) 3 3 3 3 stretch stretch;
}

QGroupBox::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    padding: 0;
    margin: 5px 0 0 -8px;
    left: 0;
    background: transparent;
    spacing: 4px;
    color: #b8cee0;
}

#titleBar_left_container {
    border-image: url(graphics:titleBar_left_container_border.svg) 0 0 2 0 stretch stretch;
    border-width: 0 0 2 0;
}

#titleBar_left_save_button {
    border-radius: 0;
    padding: 10px 12px 10px 22px;
    border-width: 1px;
    border-image: url(graphics:titleBar_left_save_button_normal.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_save_button[class=saved] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a5f70, stop:1 #3a4d5d);
    color: #bfd4e4;
    icon: url(graphics:save_light.svg);
    border-image: url(graphics:titleBar_left_save_button_normal.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_save_button[class=saved]:hover {
    border-image: url(graphics:titleBar_left_save_button_hover.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_save_button[class=saved]:pressed {
    border-image: url(graphics:titleBar_left_save_button_pressed.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_save_button[class=unsaved] {
    border-image: url(graphics:titleBar_left_save_button_unsaved_normal.svg) 1 1 1 1 stretch stretch;
    color: #304251;
    icon: url(graphics:save.svg);
}

#titleBar_left_save_button[class=unsaved]:hover {
    border-image: url(graphics:titleBar_left_save_button_unsaved_hover.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_save_button[class=unsaved]:pressed {
    border-image: url(graphics:titleBar_left_save_button_unsaved_pressed.svg) 1 1 1 1 stretch stretch;
}

#titleBar_left_export_button {
    border-radius: 0;
    border-width: 1 15 1 1;
    padding: 0;
    border-image: url(graphics:titleBar_left_export_button_normal.svg) 1 15 1 1 stretch stretch;
    background: transparent;
}

#titleBar_left_export_button:hover {
    border-image: url(graphics:titleBar_left_export_button_hover.svg) 1 15 1 1 stretch stretch;
}

#titleBar_left_export_button:pressed {
    border-image: url(graphics:titleBar_left_export_button_pressed.svg) 1 15 1 1 stretch stretch;
}

#titleBar_left_export_button #titleBar_left_export_button_icon {
    background-image: url('graphics:left_panel_export.svg');
    background-repeat: no-repeat;
    background-position: center center;    
}

#titleBar_left_export_button #titleBar_left_export_quick_button {
    border-radius: 0;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-width: 0 10 0 2;
    border-image: url(graphics:titleBar_left_export_quick_button_normal.svg) 0 10 0 2 stretch stretch;
    background-color: transparent;
    color: #ffffff;
    font-family: 'Montserrat';
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0 1 0 2;
}

#titleBar_left_export_button #titleBar_left_export_quick_button:hover {
    border-image: url(graphics:titleBar_left_export_quick_button_hover.svg) 0 10 0 2 stretch stretch;
}

#titleBar_left_export_button #titleBar_left_export_quick_button:pressed {
    border-image: url(graphics:titleBar_left_export_quick_button_pressed.svg) 0 10 0 2 stretch stretch;
}

#titleBar_left_information_container QLabel {
    color: #d9ffffff;
    font-size: 11px;
}

#tilteBar_subtitld_label {
    border-width: 1 1 1 15;
    border-image: url(graphics:titleBar_right_version_background.svg) 1 1 1 15 stretch stretch;
    color: white;
    padding: 0 10px;
    color: #26ffffff;
    font-size: 12px;
    font-family: Montserrat;
}

#start_screen_bottom_line {
    border-image: url(graphics:start_screen_top_shadow.svg) 150 10 0 10 stretch;
    border: 150 0 0 0;
    background-color: #15000000;
}

#start_screen_open_label {
    font-size: 10px;
    color:rgb(106, 116, 131);
    qproperty-alignment: "AlignVCenter | AlignRight";
    qproperty-wordWrap: true;
    text-transform: uppercase;
}

#start_screen_open_button {
    padding: 10px 40px;
    margin-bottom: 40px;
}

#start_screen_recentfiles_background {
    background-color: rgba(106, 116, 131, 24);
}

#start_screen_recent_label,
#start_screen_adver_label {
    font-size: 10px;
    color:rgb(106, 116, 131);
    text-transform: uppercase;
}

#start_screen_recent_listwidget::item {
    padding: 0;
    border-radius: 2px;
}

#start_screen_recent_listwidget::item QLabel {
    color: #80ffffff;
}

#start_screen_recent_listwidget::item QLabel[class=age] {
    color: #80ffffff;
    background-color: #52000000;
    padding: 2px;
    border-radius: 3px;
    font-size: 8px;
    text-transform: uppercase;
    font-weight: 700;
}

#start_screen_recent_listwidget::item:selected {
    background:#33b8cee0;
    color:rgb(106, 116, 131);
}

#start_screen_recent_alert {
    font-size: 14px;
    color: rgb(106, 116, 131);
    qproperty-alignment: "AlignCenter";
    padding: 40px;
}

#start_screen_adver_label_details {
    font-size: 14px;
    color:rgb(106, 116, 131);
    qproperty-alignment: "AlignTop | AlignLeft";
    qproperty-wordWrap: true;
}

QScrollArea,
#preview_panel_player QGraphicsView,
QWidget[class='transparent_panel'] {
    background: transparent;
    outline: 0;
    margin: 0;
    padding: 0;
    border: none;
}

QTabWidget {
    background: transparent;
    border: none;
}

QTabWidget::pane {
    background: transparent;
    border: none;
    /* The 1px separator runs along the full width of the tab widget — put
       it on the pane's top edge (which spans the whole widget) rather than
       on the tab bar (which is only as wide as the tabs themselves). */
    border-top: 1px solid #1ac0d4e5;
    margin-top: -1px;
}

QTabBar {
    background: transparent;
    border: none;
}

QTabBar::tab {
    background: transparent;
    color: #80b8cee0;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 7px 10px 6px 10px;
    border: none;
    border-bottom: 1px solid transparent;
}

QTabBar::tab:hover {
    color: #b8cee0;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #1ac0d4e5, stop:1 #00c0d4e5);
    color: #c8dbe9;
    border-bottom: 1px solid #b8cee0;
}

QPushButton#left_panel_global_panel_export_settings_button {
    background: transparent;
    border: none;
    border-radius: 0;
    margin-bottom: 1px;
}

QPushButton#left_panel_global_panel_export_settings_button:hover {
    background: rgba(255, 255, 255, 12);
}

QPushButton#left_panel_global_panel_export_settings_button:pressed {
    background: rgba(255, 255, 255, 22);
}

#left_panel_navigation {
    background-image: url(graphics:left_panel_navigation_background.svg);
    background-repeat: repeat-y;
    background-position: right;
}

#left_panel_navigation QPushButton[class=navigation_button] {
    outline: 0;
    margin: 0;
    padding: 10px;
    border: none;
    border-radius: 0;
    background-color: #80000000;
    border-left: 10px solid transparent;
    icon-size: 16px;
}

#left_panel_navigation QPushButton[class=navigation_button]::hover {
    border-left: 10px solid #1ab8cee0;
    background-color: #04b8cee0;
}

#left_panel_navigation QPushButton[class=navigation_button]::checked {
    border-left: 10px solid #c8dbe9;
    background-color: #0affffff; 
}

