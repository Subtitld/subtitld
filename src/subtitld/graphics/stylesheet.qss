#left_panel_speakers_panel_content_item {
    background-color: #e53e5363;
    border-radius: 2px;
}

#left_panel_speakers_panel_content_item::hover {
    background-color: #3e5363;
}

#left_panel_speakers_panel_content_item[selected=true] {
    background-color: #6a7483;
}

#left_panel_speakers_panel_content_item[selected_speaker=true] {
    background-color: #4a5d6f;
    border-left: 2px solid #b8cee0;
}

#left_panel_speakers_panel_content_item[selected_speaker=true]::hover {
    background-color: #56697b;
}

#left_panel_speakers_panel_content_item QPushButton {
    background-color: transparent;
}


#left_panel_speakers_panel_content_item QPushButton::hover {
    background-color: #80304251;
}


#left_panel_speakers_panel_content_item QPushButton::pressed {
    background-color: #40304251;
}


#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_rename_button {
    icon: url(graphics:speaker_list_item_rename_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_rename_button:hover {
    icon: url(graphics:speaker_list_item_rename_icon_hover.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_change_color_button {
    icon: url(graphics:speaker_list_item_change_color_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_change_color_button:hover {
    icon: url(graphics:speaker_list_item_change_color_icon_hover.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_change_image_button {
    icon: url(graphics:speaker_list_item_change_image_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_change_image_button:hover {
    icon: url(graphics:speaker_list_item_change_image_icon_hover.svg);
}

#dubbing_container_hideexpand_button {
    icon: url(graphics:dubbing_container_collapse_icon.svg);
}

#dubbing_container_hideexpand_button:checked {
    icon: url(graphics:dubbing_container_expand_icon.svg);
}

#dubbing_container_hideexpand_button:disabled {
    icon: url(graphics:dubbing_container_collapse_icon_disabled.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_remove_button {
    icon: url(graphics:speaker_list_item_remove_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_remove_button:hover {
    icon: url(graphics:speaker_list_item_remove_icon_hover.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_export_button {
    icon: url(graphics:speaker_list_item_export_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_export_button:hover {
    icon: url(graphics:speaker_list_item_export_icon_hover.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_visibility_button {
    icon: url(graphics:left_panel_speakers_panel_content_item_visible_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_visibility_button:checked {
    icon: url(graphics:left_panel_speakers_panel_content_item_hidden_icon.svg);
}

#left_panel_speakers_panel_content_item #left_panel_speakers_panel_content_item_bottom_line {
    background-color: #bf304251;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

#dialog_title {
    background-color: #3e5363;
    border-bottom: 1px solid #e530404c;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

#dialog_title QLabel {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
}

#dialog_title QPushButton {
    border-top-right-radius: 4px;
    border-top-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#dialog_content {
    background-color: #e53e5363;
}

#dialog_bottom {
    background-color: #3e5363;
    border-top: 1px solid #e530404c;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

#dialog_bottom QPushButton {
    padding: 10px 12px;
    font-size: 11px;
    text-transform: uppercase;
    border-radius: 0;
}

#dialog_bottom QPushButton::hover {
    background-color: #384b59;
}

#dialog_bottom QPushButton[class="accept_button"] {
    border-bottom-right-radius: 4px;
    background-color: #406a7483;
}

#dialog_bottom QPushButton[class="accept_button"]::hover {
    background-color: #384b59;
}

#dialog_title #dialog_close_button {
    icon: url(graphics:dialog_close_icon.svg);
}

#export_dialog_sidebar {
    background-color: #2b3a47;
    border-right: 1px solid #1f2b35;
}

#export_dialog_sidebar QPushButton {
    background: transparent;
    color: #b8cee0;
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 0;
    border-left: 3px solid transparent;
    font-family: 'Montserrat';
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

#export_dialog_sidebar QPushButton:hover {
    background: rgba(255, 255, 255, 8);
    color: #ffffff;
}

#export_dialog_sidebar QPushButton:checked {
    background: #3e5363;
    color: #ffffff;
    border-left: 3px solid #b8cee0;
}

#export_dialog_pages QLabel {
    color: #b8cee0;
}

#export_dialog_pages QRadioButton {
    color: #d9ffffff;
    font-size: 11px;
    padding: 4px 0;
    spacing: 8px;
}

#export_dialog_pages QCheckBox {
    padding: 4px 0;
}

#dialog_title #dialog_close_button::hover {
    icon: url(graphics:dialog_close_icon_hover.svg);
}

/* =====================================================================
   Find & Replace dialog (FindReplaceDialog — 2026 enhanced-components)
   Tokens mirror the design handoff: 30px input shell, 22×22 inline
   toggles, slate footer with status text + 3-button right cluster.
   ===================================================================== */

#find_replace_dialog QLabel[class="find_replace_section_label"] {
    color: rgba(184, 206, 224, 140);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#find_replace_field {
    background-color: #27333d;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 90);
    min-height: 30px;
    max-height: 30px;
}

#find_replace_field QLineEdit {
    background: transparent;
    color: rgba(255, 255, 255, 242);
    border: none;
    padding: 0;
    font-size: 12px;
    selection-background-color: #b8cee0;
    selection-color: #1a232b;
}

#find_replace_field QPushButton[class="find_toggle"] {
    background-color: transparent;
    color: rgba(184, 206, 224, 178);
    border: none;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
}

#find_replace_field QPushButton[class="find_toggle"]:hover {
    background-color: rgba(184, 206, 224, 36);
    color: rgba(184, 206, 224, 220);
}

#find_replace_field QPushButton[class="find_toggle"]:checked {
    background-color: #b8cee0;
    color: #1a232b;
}

#find_replace_field QPushButton[class="find_toggle"]:checked:hover {
    background-color: #c8dbe9;
}

#find_replace_dialog #dialog_bottom {
    /* The custom footer needs vertical padding the default rule strips
       off so the status label + buttons line up at a comfortable height
       without inheriting the 0-margin treatment from #dialog_bottom. */
    min-height: 44px;
}

#find_replace_dialog #dialog_bottom QLabel[class="find_replace_status"] {
    color: rgba(184, 206, 224, 153);
    font-size: 10px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    padding: 0;
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button"],
#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button_primary"] {
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
    border-radius: 2px;
    border: none;
    /* Override the default #dialog_bottom radius-0 rule so these buttons
       have their own 2px corner like the rest of the design system. */
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button"] {
    background-color: #4a5f70;
    color: #b8cee0;
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button"]:hover {
    background-color: #566f84;
    color: #ffffff;
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button_primary"] {
    background-color: #c8dbe9;
    color: #3e5363;
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button_primary"]:hover {
    background-color: #d6e4ef;
    color: #1a232b;
}

#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button"]:disabled,
#find_replace_dialog #dialog_bottom QPushButton[class="find_replace_button_primary"]:disabled {
    color: rgba(184, 206, 224, 80);
    background-color: rgba(74, 95, 112, 100);
}

#music_voice_separation_box #music_voice_separation_music_icon {
    icon: url(graphics:music_voice_separation_music_icon.svg);
    padding: 0 13px 0 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

#music_voice_separation_box #music_voice_separation_voice_icon {
    icon: url(graphics:music_voice_separation_voice_icon.svg);
    padding: 0 8px 0 13px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
}

#music_voice_separation_box #music_voice_separation_slider {
    background-color: #b8cee0;
}

#music_voice_separation_box #music_voice_separation_slider[class="middle"] {
    background-color: #6a7483;
}

#music_voice_separation_box #music_voice_separation_slider::disabled {
    background-color: #1a1e2a33;
    opacity: .5;
}

#music_voice_separation_box #music_voice_separation_music_icon::disabled {
    icon: url(graphics:music_voice_separation_music_icon_disabled.svg);
}

#music_voice_separation_box #music_voice_separation_voice_icon::disabled {
    icon: url(graphics:music_voice_separation_voice_icon_disabled.svg);
}

#global_panel_transcription_vosk_transcription_download_model_button {
    icon: url(graphics:vosk_transcription_download_model_icon.svg);
}

#global_panel_transcription_vosk_transcription_update_model_button {
    icon: url(graphics:vosk_transcription_update_model_icon.svg);
}

#global_panel_transcription_vosk_transcription_remove_model_button {
    icon: url(graphics:speaker_list_item_remove_icon.svg);
}

#global_panel_transcription_vosk_transcription_remove_model_button:hover {
    icon: url(graphics:speaker_list_item_remove_icon_hover.svg);
}

#global_panel_transcription_vosk_transcription_model_combobox QComboBox::drop-down {
    border-bottom-right-radius: 0;
}

#global_panel_transcription_vosk_transcription_model_combobox QPushButton {
    border-radius: 0;
}

#global_panel_transcription_vosk_transcription_model_combobox #global_panel_transcription_vosk_transcription_download_model_button,
#global_panel_transcription_vosk_transcription_model_combobox #global_panel_transcription_vosk_transcription_remove_model_button {
    border-bottom-right-radius: 2px;
}

#global_panel_transcription_vosk_transcription_model_combobox #global_panel_transcription_vosk_transcription_download_model_button,
#global_panel_transcription_vosk_transcription_model_combobox #global_panel_transcription_vosk_transcription_update_model_button {
    border-top-left-radius: 2px;
}

#left_panel_speakers_panel_content_item_dubbing_content {
    background-color: #1a1e2a33;
}