QPushButton {
    border-radius: 2px;
    border: 0;
    background-color: #3e5363;
    padding: 4px;
    outline: none;
}

QPushButton::hover {
    background-color: #cc3e5363;
}

QPushButton::pressed {
    background-color: #304251;
}

QMainWindow {
    background: qlineargradient( x1:0 y1:0, x2:0 y2:1, stop:0 rgb(7,9,11), stop:1 rgb(26,35,43));
    background-image: url(graphics:background_watermark.svg);
    background-repeat: no-repeat;
    background-position: center;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0 2px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(136, 136, 136, 0.5); /* semi-transparent */
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(85, 85, 85, 0.7); /* darker on hover */
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(136, 136, 136, 0.5);
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(85, 85, 85, 0.7);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QScrollBar:corner {
    background: transparent;
}

QListView,
QScrollBar,
QTextEdit {
    border: none;
    outline: none;
    background-color: transparent;
    padding: 0;
}

QToolTip {
    background-color: #e51a232b;
    color: white;
    padding: 2px;
    font-size: 10px;
    border: 0;
}

QLineEdit[class=qlineedit_timings] {
    outline: none;
    margin: 0;
    border: 0;
    padding: 0;
    font-size: 10px;
    color: grey;
    border-radius: 0;
    background-color: transparent;
}


QSpinBox,
QDoubleSpinBox {
    padding-left:1px;
    border: 0;
    background-color: #3e5363;
    min-width: 40px;
    border-radius: 2px;
    font-size: 10px;
    color:#b8cee0;
    padding: 2px;
}

QSpinBox::disabled,
QDoubleSpinBox::disabled {
    background-color: #803e5363;
}


QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: 0;
    padding: 3 5 0 0;
    border-top-right-radius: 2px;
    image: url(graphics:spinbox_arrow_up.svg);
}

QSpinBox::up-button[class=spin_playercontrols],
QDoubleSpinBox::up-button[class=spin_playercontrols] {
    margin-top: 3px;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    image: url(graphics:spinbox_arrow_up.svg);
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::up-button:off,
QDoubleSpinBox::up-button:off {
    background-color: none;
    image: none;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: 0;
    padding: 0 5 3 0;
    border-bottom-right-radius: 2px;
    image: url(graphics:spinbox_arrow_down.svg);
}

QSpinBox::down-button[class=spin_playercontrols],
QDoubleSpinBox::down-button[class=spin_playercontrols] {
    margin-bottom: 3px;
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    /* background-color: #e5b3b3b3; */
    image: url(graphics:spinbox_arrow_down.svg);
}

QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QSpinBox::down-button:off,
QDoubleSpinBox::down-button:off {
    background-color: none;
    image: none;
}


QSlider::groove:horizontal {
    outline: none;
    margin: 0;
    padding: 0;
    background: #803e5363;
}

QSlider::handle:horizontal {
    outline: none;
    border: 0;
    padding: 0;
    width: 10px;
    background: #3e5363;
}

QSlider::handle:horizontal:disabled {
    background: transparent;
}


#titleBar_left_container {
    border-image: url(graphics:titleBar_left_container_border.svg) 0 0 2 0 stretch stretch;
    border-width: 0 0 2 0;
}

#titleBar_left_save_container {
    border-bottom-right-radius: 3px;
    border-top-right-radius: 3px;
}

#titleBar_left_save_container[class=saved] {
    background-color: #b8cee0;
}

#titleBar_left_save_container[class=unsaved] {
    background-color: #67ff4d;
}

#titleBar_left_save_button {
    qproperty-icon: url(graphics:save.svg);
}

#titleBar_left_information_container QLabel {
    color: #d9ffffff;
    font-size: 11px;
}

#tilteBar_subtitld_label {
    color: white;
    padding-right: 10px;
    border-width: 1px;
    border-style: solid;
    border-color: transparent #08ffffff transparent transparent;
    color: #26ffffff;
    font-size: 12px;
    padding: 8;
    font-family: Montserrat;
}

#start_screen_bottom_line {
    border-image: url(graphics:start_screen_top_shadow.svg) 150 10 0 10 stretch;
    border: 150 0 0 0;
    background-color: #15000000;
}

#start_screen_open_label {
    font-size: 10px;
    color:rgb(106, 116, 131);
    qproperty-alignment: "AlignVCenter | AlignRight";
    qproperty-wordWrap: true;
    text-transform: uppercase;
}

#start_screen_open_button {
    padding: 10px 40px;
    margin-bottom: 40px;
}

#start_screen_recentfiles_background {
    background-color: rgba(106, 116, 131, 24);
}

#start_screen_recent_label,
#start_screen_adver_label {
    font-size: 10px;
    color:rgb(106, 116, 131);
    text-transform: uppercase;
}

#start_screen_recent_listwidget::item {
    padding: 0;
    border-radius: 2px;
}

#start_screen_recent_listwidget::item QLabel {
    color: #80ffffff;
}

#start_screen_recent_listwidget::item QLabel[class=age] {
    color: #80ffffff;
    background-color: #52000000;
    padding: 2px;
    border-radius: 3px;
    font-size: 8px;
    text-transform: uppercase;
    font-weight: 700;
}

#start_screen_recent_listwidget::item:selected {
    background:#33b8cee0;
    color:rgb(106, 116, 131);
}

#start_screen_recent_alert {
    font-size: 14px;
    color: rgb(106, 116, 131);
    qproperty-alignment: "AlignCenter";
    padding: 40px;
}

#start_screen_adver_label_details {
    font-size: 14px;
    color:rgb(106, 116, 131);
    qproperty-alignment: "AlignTop | AlignLeft";
    qproperty-wordWrap: true;
}

#preview_panel_player QGraphicsView,
#left_panel_navigation,
QScrollArea {
    background: transparent;
    outline: 0;
    margin: 0;
    padding: 0;
    border: none;
}

#left_panel_navigation {
    background-image: url(graphics:left_panel_navigation_background.svg);
    background-repeat: repeat-y;
    background-position: right;
}

#left_panel_navigation QPushButton[class=navigation_button] {
    outline: 0;
    margin: 0;
    padding: 10px;
    border: none;
    border-radius: 0;
    background-color: #80000000;
    border-left: 10px solid transparent;
    icon-size: 16px;
}

#left_panel_navigation QPushButton[class=navigation_button]::hover {
    border-left: 10px solid #1ab8cee0;
    background-color: #04b8cee0;
}

#left_panel_navigation QPushButton[class=navigation_button]::checked {
    border-left: 10px solid #80b8cee0;
    background-color: #09b8cee0;
}

#left_panel_stackedwidgets {
    border-left: 1px solid #0affffff;
    border-right: 1px solid #05ffffff;
    background-color: #40304251;
}

#send_text_buttons_container #send_text_to_last_subtitle_button {
    padding-top: 1px;
    padding-left: 32px;
    padding-right: 0;
    border-bottom-left-radius: 2px;
    icon: url(graphics:send_text_to_last_subtitle_icon.svg);
}

#send_text_buttons_container #send_text_to_last_subtitle_and_slice_button {
    padding-top: 3px;
    icon: url('graphics:send_text_to_last_subtitle_and_slice_button.svg');
}

#send_text_buttons_container #send_text_to_next_subtitle_button {
    padding-right: 32px;
    padding-left: 0;
    padding-top: 1px;
    border-bottom-right-radius: 2px;
    icon: url(graphics:send_text_to_next_subtitle_icon.svg);
}

#send_text_buttons_container #send_text_to_next_subtitle_and_slice_button {
    padding-top: 3px;
    icon: url('graphics:send_text_to_next_subtitle_and_slice_button.svg');
}

#left_panel_subtitleslist_bottom_buttons_container QPushButton,
#left_panel_subtitleslist_bottom_buttons_container QComboBox {
    border-radius: 0;
    border: 0;
}

#left_panel_subtitleslist_textedit {
    padding: 8px 8px 40px 8px;
    font-size: 14px;
    font-weight: 500;
    border-right: 1px solid #0affffff;
}

#left_panel_subtitleslist_bottom_panel {
    background-color: qlineargradient( x1:0 y1:0, x2:0 y2:.4, stop:0 #3307090b, stop:1 #1a232b);
}

#left_panel_subtitleslist_bottom_panel QLineEdit {
    font-family: 'Ubuntu Mono', monospace;
    border-top: 1px solid #0affffff;
    font-size: 15px;
    font-weight: 700;
    color: #bbffffff;
    padding: 15px 3px 6px 3px;
}

#subtitles_panel_simplelist_properties_duration_timing_lock_button {
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 0;
    border-top-left-radius: 0;
    padding: 0;
    background-color: transparent;
    icon-size: 10px;
    icon: url(graphics:subtitles_panel_simplelist_properties_duration_timing_lock_open_icon.svg);
}

#subtitles_panel_simplelist_properties_duration_timing_lock_button:hover {
    background-color: #22ffffff;
    icon: url(graphics:subtitles_panel_simplelist_properties_duration_timing_lock_open_icon_hover.svg);
}

#subtitles_panel_simplelist_properties_duration_timing_lock_button:checked,
#subtitles_panel_simplelist_properties_duration_timing_lock_button:hover:checked {
    background-color: #23ffffff;
    icon: url(graphics:subtitles_panel_simplelist_properties_duration_timing_lock_closed_icon.svg);
}

#timeline_widget {
    background-color: transparent;
}

#timeline_scroll {
    background-color: qlineargradient( x1:0 y1:0, x2:0 y2:.4, stop:0 rgba(7,9,11,0.2), stop:1 rgba(26,35,43,0));
}

#left_panel_subtitleslist_speaker_selector {
    border-top: 1px solid #0affffff;
    border-left: 1px solid #0affffff;
    border-right: 0;
    border-bottom: 0;
    border-top-left-radius: 4px;
}

#left_panel_subtitleslist_speaker_selector #selector_button_label {
    outline: none;
    margin: 0;
    padding: 0 0 0 4;
    border: none;
    border-radius: 0;
    background-color: transparent;
}

#left_panel_subtitleslist_speaker_selector #add_button {
    padding: 4px;
    border-radius: 0;
    border-bottom-left-radius: 2px;
    border: 0;
    icon-size: 10px;
    background-color: #05ffffff;
}

#left_panel_subtitleslist_speaker_selector #add_button:hover, 
#left_panel_subtitleslist_speaker_selector #add_button:hover:checked {
    background-color: #10ffffff;
}

#left_panel_subtitleslist_speaker_selector #label,
#left_panel_subtitleslist_bottom_panel QLabel[class="properties_timing_labels"] {
    font-size: 9px;
    font-weight: 700;
    color: #23ffffff;
    text-transform: uppercase;
    padding: 2px;
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_list {
    background: transparent;
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_list_widget {
    border: 1px solid #0affffff;
    border-right: 0;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background-color: #f3304251;
    padding: 0;
    selection-background-color: #33b8cee0;
    selection-color: white;   
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_list_widget::item {
    color: white;
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_list_widget::item:hover {
    background-color: #0cb8cee0;
    color: white;
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_list_widget::item:selected {
    background-color: #33b8cee0;
    color: white;
}

#left_panel_subtitleslist_speaker_selector #speaker_selector_image {
    margin-top: 1px;
    margin-right: 1px;
}

#playercontrols_timecode_label {
    font-size: 14px;
    font-weight: 700;
    color: rgba(106, 116, 131,100);
    font-family: "Ubuntu Mono", monospace;
}

#playercontrols_widget_left_top_line {
    border-image: url(graphics:playercontrols_widget_center_top_line.svg) 2 53 0 0 stretch stretch;
    border-width: 2 0 0 0;
    margin-right: 28;
}

#playercontrols_widget_center_top_line {
    border-width: 7 31 2 31;
    border-image: url(graphics:playercontrols_widget_center_top_line.svg) 7 31 2 31 stretch stretch;
}

#playercontrols_widget_right_top_line {
    border-image: url(graphics:playercontrols_widget_center_top_line.svg) 2 0 0 53 stretch stretch;
    border-width: 2 0 0 0;
    margin-left: 28;
}

#playercontrols_widget_top_line QPushButton {
    text-transform: uppercase;
    padding: 6;
    font-size: 10px;
    font-weight: 700;
    color: #B8C6E0;    
}

#playercontrols_widget_bottom_line {
    background-image: url(graphics:timeline_bottom_controls_background.svg) 0 0 0 0 stretch stretch;
}

#playercontrols_widget_left_bottom_line {
    border-image: url(graphics:playercontrols_widget_center_bottom_line.svg) 1 27 2 0 stretch stretch;
    border: 1 0 2 0;
}

#playercontrols_widget_center_bottom_line {
    border-width: 1 14 2 14;
    border-image: url(graphics:playercontrols_widget_center_bottom_line.svg) 1 14 2 14 stretch stretch;
}

#playercontrols_widget_right_bottom_line {
    border-image: url(graphics:playercontrols_widget_center_bottom_line.svg) 1 0 2 27 stretch stretch;
    margin-left: 10px;
}

#playercontrols_widget_center_top_line {
    margin: 0;
}

#playercontrols_widget_center_top_line QPushButton {
    background: transparent;
    border-radius: 0;
    padding: 0 8;
    border-left: 1px solid #14ffffff;
    border-right: 1px solid #143e5363;
}

#playercontrols_widget_center_top_line QPushButton:hover {
    background: #14304251;
    border-left: 1px solid #33ffffff;
    border-right: 1px solid #333e5363;
}

#playercontrols_widget_center_top_line QPushButton::hover:pressed,
#playercontrols_widget_center_top_line QPushButton::hover:checked,
#playercontrols_widget_center_top_line QPushButton::pressed,
#playercontrols_widget_center_top_line QPushButton::checked {
    background: #803e5363;
    border-left: 1px solid #333e5363;
    border-right: 1px solid #33ffffff;
}

#playercontrols_widget_center_top_line QPushButton[position="first"] {
    background: transparent;
    border-width: 0 1 0 13;
    border-style: none;
    padding: 0 8 0 2;
    border-image: url(graphics:playercontrols_button_first.svg) 0 1 0 13 stretch stretch;
}

#playercontrols_widget_center_top_line QPushButton[position="first"]:hover {
    background: transparent;
    border-width: 0 1 0 13;
    border-image: url(graphics:playercontrols_button_first_hover.svg) 0 1 0 13 stretch stretch;
}

#playercontrols_widget_center_top_line QPushButton[position="first"]:hover:pressed,
#playercontrols_widget_center_top_line QPushButton[position="first"]:hover:checked,
#playercontrols_widget_center_top_line QPushButton[position="first"]:pressed,
#playercontrols_widget_center_top_line QPushButton[position="first"]:checked {
    background: transparent;
    border-width: 0 1 0 13;
    border-image: url(graphics:playercontrols_button_first_pressed.svg) 0 1 0 13 stretch stretch;
}

#playercontrols_widget_center_top_line QPushButton[position="last"] {
    background: transparent;
    border-width: 0 13 0 1;
    border-style: none;
    /* padding: 0 10 0 8; */
    border-image: url(graphics:playercontrols_button_last.svg) 0 13 0 1 stretch stretch;
}

#playercontrols_widget_center_top_line QPushButton[position="last"]:hover {
    background: transparent;
    border-width: 0 13 0 1;
    border-image: url(graphics:playercontrols_button_last_hover.svg) 0 13 0 1 stretch stretch;
}

#playercontrols_widget_center_top_line QPushButton[position="last"]:pressed,
#playercontrols_widget_center_top_line QPushButton[position="last"]:hover:pressed,
#playercontrols_widget_center_top_line QPushButton[position="last"]:checked,
#playercontrols_widget_center_top_line QPushButton[position="last"]:hover:checked {
    background: transparent;
    border-width: 0 13 0 1;
    border-image: url(graphics:playercontrols_button_last_pressed.svg) 0 13 0 1 stretch stretch;
}

#playercontrols_stop_button {
    icon: url(graphics:stop_icon.svg);
}

#playercontrols_stop_button:hover {
    icon: url(graphics:stop_icon_hover.svg);
}   

#playercontrols_stop_button:hover:pressed,
#playercontrols_stop_button:pressed,
#playercontrols_stop_button:hover:checked,
#playercontrols_stop_button:checked {
    icon: url(graphics:stop_icon_pressed.svg);
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button {
    padding: 0 90 0 10;
    icon: url(graphics:play_icon.svg);
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button:hover {
    icon: url(graphics:play_icon_hover.svg);
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button:hover:pressed,
#playercontrols_widget_center_top_line #playercontrols_playpause_button:pressed {
    icon: url(graphics:play_icon_pressed.svg);
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button:hover:checked,
#playercontrols_widget_center_top_line #playercontrols_playpause_button:checked {
    icon: url(graphics:pause_icon.svg);
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button #playercontrols_play_from_next_start_button,
#playercontrols_widget_center_top_line #playercontrols_playpause_button #playercontrols_play_from_last_start_button {
    border-bottom: 1px solid #143e5363;
    padding-top: 3;
    padding-bottom: 2;
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button #playercontrols_play_from_next_start_button {
    icon: url(graphics:play_from_next_start_icon.svg);
    border-bottom-right-radius: 4px;
    padding-right: 10;
    padding-left: 0;
    border-left: none;
}

#playercontrols_widget_center_top_line #playercontrols_playpause_button #playercontrols_play_from_last_start_button {
    icon: url(graphics:play_from_last_start_icon.svg);
    border-bottom-left-radius: 4px;   
    padding-left: 10;
    padding-right: 0;
    border-right: none;
}

#playercontrols_widget_left_top_line #change_playback_speed {
    icon: url(graphics:playback_speed.svg);
    background: transparent;
    border-width: 0 16 0 16;
    border-radius: 0;
    border-image: url(graphics:playbackspeed_border.svg) 0 16 0 16 stretch stretch;
    padding-left: 140;
    padding-right: 0;
}

#playercontrols_widget_left_top_line #change_playback_speed:hover:pressed,
#playercontrols_widget_left_top_line #change_playback_speed:hover {
    border-image: url(graphics:playbackspeed_border_hover.svg) 0 16 0 16 stretch stretch;
}

#playercontrols_widget_left_top_line #change_playback_speed:checked:hover,
#playercontrols_widget_left_top_line #change_playback_speed:checked {
    border-image: url(graphics:playbackspeed_border_checked.svg) 0 16 0 16 stretch stretch;
}

#playercontrols_widget_left_top_line #change_playback_speed #change_playback_speed_label {
    font-weight:bold;
    color: #B8C6E0;
    padding-left: 1;
}

#change_playback_speed QPushButton {
    border-radius: 0;
}

#change_playback_speed #change_playback_speed_decrease {
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
}

#change_playback_speed #change_playback_speed_increase {
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

#playercontrols_widget_top_line #repeat_playback {
    icon: url(graphics:playback_repeat.svg);
    background: transparent;
    border-width: 0 16 0 16;
    border-radius: 0;
    border-image: url(graphics:repeat_playback_border.svg) 0 16 0 16 stretch stretch;
    padding-right: 140;
    padding-left: 0;
}

#playercontrols_widget_top_line #repeat_playback:hover:pressed,
#playercontrols_widget_top_line #repeat_playback:hover {
    border-image: url(graphics:repeat_playback_border_hover.svg) 0 16 0 16 stretch stretch;
}

#playercontrols_widget_top_line #repeat_playback:checked:hover,
#playercontrols_widget_top_line #repeat_playback:checked {
    border-image: url(graphics:repeat_playback_border_checked.svg) 0 16 0 16 stretch stretch;
}

#playercontrols_widget_top_line #repeat_playback #repeat_playback_x_label {
    font-weight:bold;
    color: #B8C6E0;
}

#gap_hbox #gap_subtitle_duration, 
#add_subtitle_button #add_subtitle_duration,
#playercontrols_widget_left_top_line #add_subtitle_button QPushButton {
    border: 1px solid #40304251;
}

#gap_hbox #gap_add_subtitle_button {
    padding: 0 32px 0 10px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    qproperty-icon: url(graphics:gap_add_icon.svg);
}

#gap_hbox #gap_remove_subtitle_button {
    padding: 0 10px 0 32px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    qproperty-icon: url(graphics:gap_remove_icon.svg);
}

#playercontrols_widget_top_line #add_subtitle_button {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    padding: 0 135 0 10;
    qproperty-icon: url(graphics:add_subtitle_icon.svg);
}

#playercontrols_widget_top_line #add_subtitle_button QPushButton {
    padding: 6 6 0 6;
    border-top: none;
    border-radius: 0;
}

#playercontrols_widget_top_line #add_subtitle_button QPushButton:checked,
#playercontrols_widget_top_line #add_subtitle_button QPushButton:hover:checked,
#playercontrols_widget_bottom_line QPushButton:checked,
#playercontrols_widget_bottom_line QPushButton:hover:checked {
    background-color: #80304251;
}

#playercontrols_widget_top_line #add_subtitle_button #add_subtitle_starting_from_last {
    border-bottom-left-radius: 2px;
    border-right: none;
    padding-right: 0;
    icon: url(graphics:add_from_last.svg);
}

#playercontrols_widget_top_line #add_subtitle_button #add_subtitle_starting_from_last:checked,
