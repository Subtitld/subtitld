SUMMARY="Read and write sound files through libsndfile"
DESCRIPTION="Reads and writes sound files in the many formats libsndfile supports, \
returning and accepting audio as NumPy arrays, with support for seeking and \
block-wise processing."
HOMEPAGE="https://github.com/bastibe/python-soundfile"
COPYRIGHT="2026 Bastian Bechtold"
LICENSE="BSD (3-clause)"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/d2/db/949331952a6fb1c5b12e9de80fd08747966c2039d1a61db4764fbd3981c2/soundfile-0.14.0.tar.gz"
CHECKSUM_SHA256="ba1c1a2d618bca5c406647c83b89f07cc8810fa506a50622a6993ba130c1de11"
SOURCE_DIR="soundfile-0.14.0"

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.10)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		soundfile_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		cffi_$pythonPackage
		lib:libsndfile
		\""

	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		cffi_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		installLocation=$prefix/lib/$python/vendor-packages/
		export PYTHONPATH=$installLocation:$PYTHONPATH

		mkdir -p $installLocation
		rm -rf build

		$python setup.py build install \
			--root=/ --prefix=$prefix

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
