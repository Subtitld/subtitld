SUMMARY="A CSS Cascading Style Sheets library for Python"
DESCRIPTION="Parses CSS into a DOM-like object model that can be inspected and modified, \
then serialised back out to CSS text. It follows the W3C CSSOM specifications."
HOMEPAGE="https://pypi.org/project/cssutils/"
COPYRIGHT="2026 Christof Hoeke"
LICENSE="GNU LGPL v3"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/01/bf/5669e08a6f53e0d4b4648a989e77163ad36d4718195319c8c5af08ded654/cssutils-2.15.0-py3-none-any.whl"
CHECKSUM_SHA256="207faa466810a1aef109261673f2458356d0839ddedaebc0ee553376290fb6a9"
SOURCE_DIR=""

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.10)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		cssutils_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		installLocation=$prefix/lib/$python/vendor-packages/
		export PYTHONPATH=$installLocation:$PYTHONPATH

		mkdir -p $installLocation
		rm -rf build

		# Upstream ships no setup.py (PEP 517-only) and its build backend
		# (hatchling/flit) is not packaged for Haiku yet. This is a pure-Python
		# wheel, which haikuporter has already unpacked, so install its contents
		# directly - they include the .dist-info that importlib.metadata reads.
		cp -R ./* $installLocation/

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
