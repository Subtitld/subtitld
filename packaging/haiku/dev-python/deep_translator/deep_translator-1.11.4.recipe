SUMMARY="Translate text between languages using several online providers"
DESCRIPTION="A flexible translation library that exposes several online translation \
providers through a single API, so the backend can be swapped without changing \
calling code."
HOMEPAGE="https://github.com/nidhaloff/deep_translator"
COPYRIGHT="2023 Nidhal Baccouri"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/38/3f/61a8ef73236dbea83a1a063a8af2f8e1e41a0df64f122233938391d0f175/deep_translator-1.11.4-py3-none-any.whl"
CHECKSUM_SHA256="d635df037e23fa35d12fd42dab72a0b55c9dd19e6292009ee7207e3f30b9e60a"
SOURCE_DIR=""

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.10)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		deep_translator_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		beautifulsoup4_$pythonPackage
		requests_$pythonPackage
		\""

	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		installLocation=$prefix/lib/$python/vendor-packages/
		export PYTHONPATH=$installLocation:$PYTHONPATH

		mkdir -p $installLocation
		rm -rf build

		# Upstream ships no setup.py (PEP 517-only) and its build backend
		# (hatchling/flit) is not packaged for Haiku yet. This is a pure-Python
		# wheel, which haikuporter has already unpacked, so install its contents
		# directly - they include the .dist-info that importlib.metadata reads.
		cp -R ./* $installLocation/

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
