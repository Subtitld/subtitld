SUMMARY="Determine platform-specific directories for app data and config"
DESCRIPTION="Works out the correct per-platform locations for application data, \
configuration, cache, state and log directories, so applications do not have \
to encode those conventions themselves."
HOMEPAGE="https://pypi.org/project/platformdirs/"
COPYRIGHT="2026 Bernát Gábor"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/f4/e1/5b7b8bbb55084d1425bcb9bc823ff519e1b2be05f6ebb0089e2eacc38413/platformdirs-4.11.8-py3-none-any.whl"
CHECKSUM_SHA256="52f2f181bbfde907966932cc8312d967d02976422d66d537ea16092b8e291081"
SOURCE_DIR=""

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.10)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		platformdirs_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		installLocation=$prefix/lib/$python/vendor-packages/
		export PYTHONPATH=$installLocation:$PYTHONPATH

		mkdir -p $installLocation
		rm -rf build

		# Upstream ships no setup.py (PEP 517-only) and its build backend
		# (hatchling/flit) is not packaged for Haiku yet. This is a pure-Python
		# wheel, which haikuporter has already unpacked, so install its contents
		# directly - they include the .dist-info that importlib.metadata reads.
		cp -R ./* $installLocation/

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
