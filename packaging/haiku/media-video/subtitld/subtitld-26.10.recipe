SUMMARY="A subtitle and caption editor"
DESCRIPTION="Subtitld creates and edits subtitles and captions. It has a \
timeline with the sound's waveform, a video preview, speakers with their own \
colours, and online synthetic voices (Microsoft Edge, Google) to dub with. It \
reads and writes the common subtitle formats: SRT, WebVTT, ASS and SSA, TTML, \
SAMI, SCC and more. Projects (.usfx) keep the video, the subtitles and the \
place you left them."
HOMEPAGE="https://subtitld.org"
COPYRIGHT="2020-2026 Jonatã Bolzan Loss"
LICENSE="GNU GPL v3
	MPL v2.0
	BSD (3-clause)
	MIT"
REVISION="1"
SOURCE_URI="https://github.com/Subtitld/subtitld/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="282f49d3cca716a20b79a928dec13f7b2c520406a8c5e40ae29503638f10aac9"
# libdatachannel, for live co-editing's direct links between collaborators, built
# into Subtitld's own folder: HaikuPorts' (libnice, and usrsctp's Linux
# sockaddr_conn) cannot open a link on Haiku. GitHub's archive of a tag has no
# submodules: libjuice, usrsctp and plog come at the commits the tag points to.
SOURCE_URI_2="https://github.com/paullouisageneau/libdatachannel/archive/refs/tags/v0.23.2.tar.gz"
CHECKSUM_SHA256_2="b9606efc5b2b173f2d22d0be3f6ba4f12af78c00ca02cde5932f3ff902980eb9"
SOURCE_FILENAME_2="libdatachannel-0.23.2.tar.gz"
SOURCE_DIR_2="libdatachannel-0.23.2"
srcGitRev_3="b509b6c1f90e4a1d4753e6bde62ffbeb4d10c6bb"
SOURCE_URI_3="https://github.com/paullouisageneau/libjuice/archive/$srcGitRev_3.tar.gz"
CHECKSUM_SHA256_3="770eb342b98e029b74de95a3078499184093a1e382e8cba12eaab3cbc91a85bd"
SOURCE_FILENAME_3="libjuice-$srcGitRev_3.tar.gz"
SOURCE_DIR_3="libjuice-$srcGitRev_3"
srcGitRev_4="fec583d54493f879d2ae44a743423bf8a04371ab"
SOURCE_URI_4="https://github.com/paullouisageneau/usrsctp/archive/$srcGitRev_4.tar.gz"
CHECKSUM_SHA256_4="e5c114afe73c9a0ec419fab5f5b3f63f3ce57b09b90d06ea85e63dca8aed3e7c"
SOURCE_FILENAME_4="usrsctp-$srcGitRev_4.tar.gz"
SOURCE_DIR_4="usrsctp-$srcGitRev_4"
srcGitRev_5="94899e0b926ac1b0f4750bfbd495167b4a6ae9ef"
SOURCE_URI_5="https://github.com/SergiusTheBest/plog/archive/$srcGitRev_5.tar.gz"
CHECKSUM_SHA256_5="92a08bce559b5f28aa88d3fd9071567414b9f43a83fe2a05a6dd14f1da536072"
SOURCE_FILENAME_5="plog-$srcGitRev_5.tar.gz"
SOURCE_DIR_5="plog-$srcGitRev_5"
ADDITIONAL_FILES="
	launcher.c
	subtitld.rdef.in
	subtitld-filetypes.sh
	libjuice-urandom.patch
	usrsctp-haiku.patch
	"
# Subtitld's projects (.usfx) as a file type, with their icon, once installed.
POST_INSTALL_SCRIPTS="$relativePostInstallDir/subtitld-filetypes.sh"

# pyside6 is x86_64-only on Haiku, so the app follows it.
ARCHITECTURES="x86_64"

PROVIDES="
	subtitld = $portVersion
	app:Subtitld = $portVersion
	cmd:subtitld = $portVersion
	"
REQUIRES="
	haiku
	beautifulsoup4_python310
	chardet_python310
	edge_tts_python310
	gtts_python310
	lxml_python310
	numpy_python310
	opencv_python3.10
	platformdirs_python310
	pyside6
	pysubs2_python310
	python_docx_python310
	python_i18n_python310
	requests_python310
	scipy_python310
	sounddevice_python310
	soundfile_python310
	# Optional for pyside6 on Haiku, but the preview panel needs it.
	lib:libQt6Multimedia
	lib:libQt6MultimediaWidgets
	# Live co-editing: the link to subtitld.cc, and libdatachannel's TLS.
	lib:libQt6WebSockets
	lib:libssl
	lib:libcrypto
	cmd:ffmpeg
	cmd:python3.10
	"

BUILD_REQUIRES="
	haiku_devel
	build_python310
	devel:libpython3.10
	installer_python310
	setuptools_python310
	wheel_python310
	devel:libssl
	devel:libcrypto
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:ninja
	cmd:patch
	cmd:g++
	cmd:gcc
	cmd:python3.10
	cmd:python3.10_config
	"

BUILD()
{
	# libdatachannel's submodules, and its patches ($portDir is set here, not
	# in PATCH).
	local deps=$sourceDir2/deps
	rmdir $deps/libjuice $deps/usrsctp $deps/plog
	ln -s $sourceDir3 $deps/libjuice
	ln -s $sourceDir4 $deps/usrsctp
	ln -s $sourceDir5 $deps/plog
	# libjuice's ICE credentials from /dev/urandom rather than rand(); usrsctp
	# built for Haiku, with the sockaddr layout Haiku has (sa_len first).
	patch -d $sourceDir3 -p1 < $portDir/additional-files/libjuice-urandom.patch
	patch -d $sourceDir4 -p1 < $portDir/additional-files/usrsctp-haiku.patch

	# The tag's sources carry a placeholder version; the package's is this one.
	sed -i "s/^__version__ = .*/__version__ = '$portVersion'/" src/subtitld/__init__.py

	python3.10 -m build --wheel --no-isolation

	# The application itself: a native program that runs Subtitld inside the
	# system's Python, so Deskbar shows Subtitld, not Python (launcher.c).
	gcc -O2 -o subtitld-launcher $portDir/additional-files/launcher.c \
		$(python3.10-config --includes) -lpython3.10 \
		-DPYTHON="\"$prefix/bin/python3.10\""

	# libdatachannel: data channels only. usrsctp has sconn_len here, and
	# libdatachannel's own code has to know it too.
	cmake -S $sourceDir2 -B libdatachannel-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
		-DNO_MEDIA=ON -DNO_WEBSOCKET=ON -DNO_EXAMPLES=ON -DNO_TESTS=ON \
		-DCMAKE_CXX_FLAGS=-DHAVE_SCONN_LEN
	ninja -C libdatachannel-build $jobArgs
}

INSTALL()
{
	python3.10 -m installer -p $prefix dist/*.whl

	# libdatachannel where Subtitld looks first (modules/rtc.py: subtitld/lib),
	# with its licences.
	local package=$(echo $prefix/lib/python3.10/*-packages/subtitld)
	mkdir -p $package/lib $docDir/libdatachannel
	cp libdatachannel-build/libdatachannel.so.0.23.2 $package/lib/libdatachannel.so
	cp $sourceDir2/LICENSE $docDir/libdatachannel/LICENSE
	cp $sourceDir3/LICENSE $docDir/libdatachannel/LICENSE.libjuice
	cp $sourceDir4/LICENSE.md $docDir/libdatachannel/LICENSE.usrsctp
	cp $sourceDir5/LICENSE $docDir/libdatachannel/LICENSE.plog

	# The application, in the apps directory: the launcher, with its
	# signature, version and icon as resources (subtitld.rdef.in).
	mkdir -p $appsDir
	cp subtitld-launcher $appsDir/Subtitld
	# A release is "26.10"; a build, "26.10.18.0446".
	local major middle minor
	IFS=. read -r major middle minor _ <<< "$portVersion"
	major=$((10#$major)) middle=$((10#${middle:-0})) minor=$((10#${minor:-0}))
	sed -e "s|@MAJOR@|$major|" -e "s|@MIDDLE@|$middle|" -e "s|@MINOR@|$minor|" \
		$portDir/additional-files/subtitld.rdef.in > subtitld.rdef
	addResourcesToBinaries subtitld.rdef $appsDir/Subtitld

	addAppDeskbarSymlink $appsDir/Subtitld

	# Adds the .usfx type to the MIME database (setmime), with its icon.
	mkdir -p $postInstallDir
	cp $portDir/additional-files/subtitld-filetypes.sh $postInstallDir/
	chmod 755 $postInstallDir/subtitld-filetypes.sh
}

TEST()
{
	# Import the UI modules headlessly; this catches missing dependencies
	# without needing app_server.
	QT_QPA_PLATFORM=offscreen python3.10 -c "
from subtitld.interface import startscreen, productionscreen, top_bar
from subtitld.modules import audioengine, file_io
print('subtitld imports OK')
"
}
