<?xml version="1.0" encoding="utf-8"?>
<!--
  Fields marked PLACEHOLDER_* must be substituted at build time with values
  obtained from Microsoft Partner Center after the "Subtitld" app reservation:
    PLACEHOLDER_PUBLISHER_ID       app Package Identity Name prefix (e.g. "12345SubtitldStudio.Subtitld")
    PLACEHOLDER_PUBLISHER_CN       Publisher certificate subject (e.g. "CN=ABCD1234-...")
    PLACEHOLDER_VERSION            four-part version matching pyproject.toml (e.g. 26.3.0.0)
    PLACEHOLDER_PUBLISHER_DISPLAY  friendly publisher name shown in Store
  The build-msix.ps1 script does this substitution before calling makeappx.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
    IgnorableNamespaces="uap rescap com desktop2">

  <Identity
      Name="PLACEHOLDER_PUBLISHER_ID"
      Publisher="PLACEHOLDER_PUBLISHER_CN"
      Version="PLACEHOLDER_VERSION"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Subtitld</DisplayName>
    <PublisherDisplayName>PLACEHOLDER_PUBLISHER_DISPLAY</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Create, edit, transcribe, translate and dub subtitles</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="Subtitld"
                 Executable="Subtitld.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Subtitld"
          Description="Create, edit, transcribe, translate and dub subtitles"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="usfx">
            <uap:DisplayName>Subtitld project</uap:DisplayName>
            <uap:Logo>Assets\UsfxFile.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.usfx</uap:FileType>
            </uap:SupportedFileTypes>
            <!-- Its thumbnail in Explorer: UsfxThumbnail.dll, below. -->
            <desktop2:ThumbnailHandler Clsid="59A8C040-1202-4033-8DB5-F5E7A7709527" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Subtitld project thumbnails">
              <com:Class Id="59A8C040-1202-4033-8DB5-F5E7A7709527" Path="UsfxThumbnail.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="subtitleformats">
            <uap:SupportedFileTypes>
              <uap:FileType>.srt</uap:FileType>
              <uap:FileType>.vtt</uap:FileType>
              <uap:FileType>.ass</uap:FileType>
              <uap:FileType>.ssa</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- subtitld:// links, subtitld.cc's "Open in Subtitld" for a shared project: the link comes as the
             first argument, as a file does. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="subtitld" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Subtitld</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <!-- Live co-editing: collaborators send each other media directly (WebRTC data channels, over UDP).
         Without the rule, Windows asks the first time, and a "Cancel" blocks links on the local network. -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Subtitld.exe">
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
