# Maintainer: Jonatã Bolzan Loss <jbopen@gmail.com>
_name=deep_translator
pkgname=python-deep-translator
pkgver=1.11.4
pkgrel=1
pkgdesc="Translate between languages using multiple translators"
arch=('any')
url="https://github.com/nidhaloff/deep_translator"
license=('MIT')
depends=('python' 'python-beautifulsoup4' 'python-requests')
optdepends=('python-docx2txt: translate .docx files'
            'python-pypdf: translate .pdf files')
makedepends=('python-build' 'python-installer' 'python-poetry-core')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha256sums=('801260c69231138707ea88a0955e484db7d40e210c9e0ae0f77372ffda5f4bf5')

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
